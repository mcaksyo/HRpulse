# PulseHR Environment Configuration

# PostgreSQL
POSTGRES_DB=pulsehr
POSTGRES_USER=pulsehr
POSTGRES_PASSWORD=pulsehr_secret

# Database URL (for local run without Docker)
DATABASE_URL=postgresql+asyncpg://pulsehr:pulsehr_secret@localhost:5432/pulsehr

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# VAPID Keys (Web Push)
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_CLAIMS_EMAIL=mailto:admin@pulsehr.local

# SMS Provider (mock in MVP)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_NAME=PulseHR

# Email (mock in MVP)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@pulsehr.local

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Frontend URL
FRONTEND_URL=http://localhost:5173

# App Settings
APP_NAME=PulseHR
APP_ENV=development
DEBUG=true
