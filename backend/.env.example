# PulseHR Backend

## Переменные окружения

# База данных
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pulsehr

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string

# VAPID ключи для Web Push (сгенерируйте свои)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@pulsehr.ru

# SMS (мок)
SMS_API_URL=https://sms.example.com/api/send
SMS_API_KEY=mock-sms-api-key

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
